{
  "book": "the_7_habits_of_highly_effective_people",
  "total_audio_duration_sec": 143.59,
  "scenes": [
    {
      "scene_id": 1,
      "start_sec": 0.0,
      "end_sec": 4.65,
      "duration_sec": 4.65,
      "script_text": "The Seven Habits of Highly Effective People by Stephen Covey in two minutes."
    },
    {
      "scene_id": 2,
      "start_sec": 4.65,
      "end_sec": 8.73,
      "duration_sec": 4.08,
      "script_text": "Most people live their entire lives in reaction mode."
    },
    {
      "scene_id": 3,
      "start_sec": 8.73,
      "end_sec": 12.29,
      "duration_sec": 3.56,
      "script_text": "They blame their boss, the economy, or the weather,"
    },
    {
      "scene_id": 4,
      "start_sec": 12.29,
      "end_sec": 16.95,
      "duration_sec": 4.66,
      "script_text": "feeling completely powerless. But here is the brutal truth."
    },
    {
      "scene_id": 5,
      "start_sec": 16.95,
      "end_sec": 21.51,
      "duration_sec": 4.56,
      "script_text": "If you want to change your life, you have to work from the inside out."
    },
    {
      "scene_id": 6,
      "start_sec": 21.51,
      "end_sec": 24.59,
      "duration_sec": 3.08,
      "script_text": "Habit One. Be proactive."
    },
    {
      "scene_id": 7,
      "start_sec": 24.59,
      "end_sec": 28.76,
      "duration_sec": 4.17,
      "script_text": "Unsuccessful people obsess over their Circle of Concern,"
    },
    {
      "scene_id": 8,
      "start_sec": 28.76,
      "end_sec": 31.7,
      "duration_sec": 2.94,
      "script_text": "worrying about things they cannot control."
    },
    {
      "scene_id": 9,
      "start_sec": 31.7,
      "end_sec": 36.78,
      "duration_sec": 5.08,
      "script_text": "Highly effective people pour all their energy into their Circle of Influence."
    },
    {
      "scene_id": 10,
      "start_sec": 36.78,
      "end_sec": 39.54,
      "duration_sec": 2.76,
      "script_text": "You are not a product of your circumstances."
    },
    {
      "scene_id": 11,
      "start_sec": 39.54,
      "end_sec": 43.52,
      "duration_sec": 3.98,
      "script_text": "You are a product of your decisions. Habit Two."
    },
    {
      "scene_id": 12,
      "start_sec": 43.52,
      "end_sec": 47.92,
      "duration_sec": 4.4,
      "script_text": "Begin with the end in mind. Imagine attending your own funeral three years"
    },
    {
      "scene_id": 13,
      "start_sec": 47.92,
      "end_sec": 52.34,
      "duration_sec": 4.42,
      "script_text": "from now. What do you want your family and friends to say about your character?"
    },
    {
      "scene_id": 14,
      "start_sec": 52.34,
      "end_sec": 55.05,
      "duration_sec": 2.71,
      "script_text": "If your ladder is leaning against the wrong wall,"
    },
    {
      "scene_id": 15,
      "start_sec": 55.05,
      "end_sec": 58.94,
      "duration_sec": 3.89,
      "script_text": "every single step you take just gets you to the wrong place faster."
    },
    {
      "scene_id": 16,
      "start_sec": 58.94,
      "end_sec": 61.75,
      "duration_sec": 2.81,
      "script_text": "Habit Three. Put first things first."
    },
    {
      "scene_id": 17,
      "start_sec": 61.75,
      "end_sec": 65.11,
      "duration_sec": 3.36,
      "script_text": "Most people spend their days putting out urgent fires."
    },
    {
      "scene_id": 18,
      "start_sec": 65.11,
      "end_sec": 67.59,
      "duration_sec": 2.48,
      "script_text": "But urgent rarely means important."
    },
    {
      "scene_id": 19,
      "start_sec": 67.59,
      "end_sec": 70.07,
      "duration_sec": 2.48,
      "script_text": "You must schedule your big rocks first."
    },
    {
      "scene_id": 20,
      "start_sec": 70.07,
      "end_sec": 72.88,
      "duration_sec": 2.81,
      "script_text": "Your deep work, your health, and your family,"
    },
    {
      "scene_id": 21,
      "start_sec": 72.88,
      "end_sec": 77.33,
      "duration_sec": 4.45,
      "script_text": "before the small pebbles and sand consume your day. Habit Four."
    },
    {
      "scene_id": 22,
      "start_sec": 77.33,
      "end_sec": 81.77,
      "duration_sec": 4.44,
      "script_text": "Think win win. Life is not a zero sum game where someone must"
    },
    {
      "scene_id": 23,
      "start_sec": 81.77,
      "end_sec": 86.15,
      "duration_sec": 4.38,
      "script_text": "lose for you to win. Scarcity mindset creates bitter enemies."
    },
    {
      "scene_id": 24,
      "start_sec": 86.15,
      "end_sec": 89.36,
      "duration_sec": 3.21,
      "script_text": "An abundance mindset builds lasting empires."
    },
    {
      "scene_id": 25,
      "start_sec": 89.36,
      "end_sec": 92.4,
      "duration_sec": 3.04,
      "script_text": "Habit Five. Seek first to understand,"
    },
    {
      "scene_id": 26,
      "start_sec": 92.4,
      "end_sec": 96.76,
      "duration_sec": 4.36,
      "script_text": "then to be understood. Most people do not listen to understand."
    },
    {
      "scene_id": 27,
      "start_sec": 96.76,
      "end_sec": 99.31,
      "duration_sec": 2.55,
      "script_text": "They listen with the intent to reply."
    },
    {
      "scene_id": 28,
      "start_sec": 99.31,
      "end_sec": 102.82,
      "duration_sec": 3.51,
      "script_text": "Diagnose before you prescribe. Habit Six."
    },
    {
      "scene_id": 29,
      "start_sec": 102.82,
      "end_sec": 106.5,
      "duration_sec": 3.68,
      "script_text": "Synergize. One plus one does not equal two."
    },
    {
      "scene_id": 30,
      "start_sec": 106.5,
      "end_sec": 110.62,
      "duration_sec": 4.12,
      "script_text": "When two creative minds combine, one plus one equals three,"
    },
    {
      "scene_id": 31,
      "start_sec": 110.62,
      "end_sec": 113.55,
      "duration_sec": 2.93,
      "script_text": "five, or ten. Value the differences."
    },
    {
      "scene_id": 32,
      "start_sec": 113.55,
      "end_sec": 116.49,
      "duration_sec": 2.94,
      "script_text": "Habit Seven. Sharpen the saw."
    },
    {
      "scene_id": 33,
      "start_sec": 116.49,
      "end_sec": 120.84,
      "duration_sec": 4.35,
      "script_text": "A lumberjack spent five hours furiously trying to chop down a tree with"
    },
    {
      "scene_id": 34,
      "start_sec": 120.84,
      "end_sec": 124.93,
      "duration_sec": 4.09,
      "script_text": "a blunt blade. When asked to stop and sharpen his saw,"
    },
    {
      "scene_id": 35,
      "start_sec": 124.93,
      "end_sec": 127.41,
      "duration_sec": 2.48,
      "script_text": "he said, I do not have time,"
    },
    {
      "scene_id": 36,
      "start_sec": 127.41,
      "end_sec": 131.75,
      "duration_sec": 4.34,
      "script_text": "I am too busy sawing. If you never recharge your physical,"
    },
    {
      "scene_id": 37,
      "start_sec": 131.75,
      "end_sec": 135.28,
      "duration_sec": 3.53,
      "script_text": "mental, and spiritual energy, you will inevitably burn out."
    },
    {
      "scene_id": 38,
      "start_sec": 135.28,
      "end_sec": 139.97,
      "duration_sec": 4.69,
      "script_text": "So tell me in the comments below. Would you rather stay stuck reacting to the world's"
    },
    {
      "scene_id": 39,
      "start_sec": 139.97,
      "end_sec": 143.59,
      "duration_sec": 3.62,
      "script_text": "chaos, or master the seven habits and become the author of your own destiny?"
    }
  ]
}