[
  {
    "scene": 1,
    "script": "The Power of Now by Eckhart Tolle in two minutes.",
    "cut_start": 0.0,
    "cut_end": 3.223,
    "duration": 3.223,
    "speech_start": 0.0,
    "speech_end": 3.048
  },
  {
    "scene": 2,
    "script": "Most people spend their entire lives trapped inside a noisy mental prison.",
    "cut_start": 3.223,
    "cut_end": 8.109,
    "duration": 4.886,
    "speech_start": 3.398,
    "speech_end": 7.934
  },
  {
    "scene": 3,
    "script": "A non-stop voice in your head that criticizes, worries, and never shuts up.",
    "cut_start": 8.109,
    "cut_end": 13.883,
    "duration": 5.774,
    "speech_start": 8.284,
    "speech_end": 13.708
  },
  {
    "scene": 4,
    "script": "You replay embarrassing memories from ten years ago at three in the morning.",
    "cut_start": 13.883,
    "cut_end": 17.881,
    "duration": 3.998,
    "speech_start": 14.058,
    "speech_end": 17.706
  },
  {
    "scene": 5,
    "script": "And you invent imaginary disasters about a future that does not even exist.",
    "cut_start": 17.881,
    "cut_end": 22.767,
    "duration": 4.886,
    "speech_start": 18.056,
    "speech_end": 22.592
  },
  {
    "scene": 6,
    "script": "But here is the life-altering truth: you are not your voice.",
    "cut_start": 22.767,
    "cut_end": 27.125,
    "duration": 4.358,
    "speech_start": 22.942,
    "speech_end": 26.95
  },
  {
    "scene": 7,
    "script": "You are not your thoughts, your worries, or your mental chatter.",
    "cut_start": 27.125,
    "cut_end": 30.763,
    "duration": 3.638,
    "speech_start": 27.3,
    "speech_end": 30.588
  },
  {
    "scene": 8,
    "script": "You are the silent, conscious awareness observing the thinker.",
    "cut_start": 30.763,
    "cut_end": 34.401,
    "duration": 3.638,
    "speech_start": 30.938,
    "speech_end": 34.226
  },
  {
    "scene": 9,
    "script": "Most human suffering is born from an obsession with psychological time.",
    "cut_start": 34.401,
    "cut_end": 38.879,
    "duration": 4.478,
    "speech_start": 34.576,
    "speech_end": 38.704
  },
  {
    "scene": 10,
    "script": "The ego constantly runs away from the present moment.",
    "cut_start": 38.879,
    "cut_end": 42.133,
    "duration": 3.254,
    "speech_start": 39.054,
    "speech_end": 41.958
  },
  {
    "scene": 11,
    "script": "It drags you into the past through regret, resentment, and guilt.",
    "cut_start": 42.133,
    "cut_end": 47.019,
    "duration": 4.886,
    "speech_start": 42.308,
    "speech_end": 46.844
  },
  {
    "scene": 12,
    "script": "Or it hurls you into the future through anxiety, stress, and fear.",
    "cut_start": 47.019,
    "cut_end": 51.713,
    "duration": 4.694,
    "speech_start": 47.194,
    "speech_end": 51.538
  },
  {
    "scene": 13,
    "script": "But the past is nothing more than a memory trace in your mind.",
    "cut_start": 51.713,
    "cut_end": 55.447,
    "duration": 3.734,
    "speech_start": 51.888,
    "speech_end": 55.272
  },
  {
    "scene": 14,
    "script": "And the future is just an imagined phantom that has not arrived.",
    "cut_start": 55.447,
    "cut_end": 59.373,
    "duration": 3.926,
    "speech_start": 55.622,
    "speech_end": 59.198
  },
  {
    "scene": 15,
    "script": "Real life only ever happens in this one singular moment: right now.",
    "cut_start": 59.373,
    "cut_end": 64.067,
    "duration": 4.694,
    "speech_start": 59.548,
    "speech_end": 63.892
  },
  {
    "scene": 16,
    "script": "Have you ever experienced anything outside of the present moment?",
    "cut_start": 64.067,
    "cut_end": 67.513,
    "duration": 3.446,
    "speech_start": 64.242,
    "speech_end": 67.338
  },
  {
    "scene": 17,
    "script": "The answer is never, and you never will.",
    "cut_start": 67.513,
    "cut_end": 70.671,
    "duration": 3.158,
    "speech_start": 67.688,
    "speech_end": 70.496
  },
  {
    "scene": 18,
    "script": "Inside your mind lurks an emotional monster called the pain-body.",
    "cut_start": 70.671,
    "cut_end": 75.269,
    "duration": 4.598,
    "speech_start": 70.846,
    "speech_end": 75.094
  },
  {
    "scene": 19,
    "script": "It feeds on negative drama, victim stories, and emotional turbulence.",
    "cut_start": 75.269,
    "cut_end": 80.323,
    "duration": 5.054,
    "speech_start": 75.444,
    "speech_end": 80.148
  },
  {
    "scene": 20,
    "script": "It tricks you into believing that your suffering is your true identity.",
    "cut_start": 80.323,
    "cut_end": 84.489,
    "duration": 4.166,
    "speech_start": 80.498,
    "speech_end": 84.314
  },
  {
    "scene": 21,
    "script": "The moment you argue, complain, or attack, the pain-body grows stronger.",
    "cut_start": 84.489,
    "cut_end": 88.967,
    "duration": 4.478,
    "speech_start": 84.664,
    "speech_end": 88.792
  },
  {
    "scene": 22,
    "script": "But when you simply watch it without judgment, it instantly loses its grip.",
    "cut_start": 88.967,
    "cut_end": 93.133,
    "duration": 4.166,
    "speech_start": 89.142,
    "speech_end": 92.958
  },
  {
    "scene": 23,
    "script": "Presence is the ultimate superpower against mental chaos.",
    "cut_start": 93.133,
    "cut_end": 96.939,
    "duration": 3.806,
    "speech_start": 93.308,
    "speech_end": 96.764
  },
  {
    "scene": 24,
    "script": "Whenever stress overwhelms you, ask yourself one simple question:",
    "cut_start": 96.939,
    "cut_end": 101.225,
    "duration": 4.286,
    "speech_start": 97.114,
    "speech_end": 101.05
  },
  {
    "scene": 25,
    "script": "What problem do I have right now, in this exact second?",
    "cut_start": 101.225,
    "cut_end": 104.863,
    "duration": 3.638,
    "speech_start": 101.4,
    "speech_end": 104.688
  },
  {
    "scene": 26,
    "script": "Not tomorrow, not five minutes from now, but this exact breath.",
    "cut_start": 104.863,
    "cut_end": 109.821,
    "duration": 4.958,
    "speech_start": 105.038,
    "speech_end": 109.646
  },
  {
    "scene": 27,
    "script": "In the immediate present, there is only this task, this step, and stillness.",
    "cut_start": 109.821,
    "cut_end": 115.715,
    "duration": 5.894,
    "speech_start": 109.996,
    "speech_end": 115.54
  },
  {
    "scene": 28,
    "script": "To dissolve suffering, you must practice radical surrender.",
    "cut_start": 115.715,
    "cut_end": 119.569,
    "duration": 3.854,
    "speech_start": 115.89,
    "speech_end": 119.394
  },
  {
    "scene": 29,
    "script": "Surrender does not mean giving up or being passive.",
    "cut_start": 119.569,
    "cut_end": 123.207,
    "duration": 3.638,
    "speech_start": 119.744,
    "speech_end": 123.032
  },
  {
    "scene": 30,
    "script": "It means saying an unconditional yes to what already is.",
    "cut_start": 123.207,
    "cut_end": 127.205,
    "duration": 3.998,
    "speech_start": 123.382,
    "speech_end": 127.03
  },
  {
    "scene": 31,
    "script": "Resisting reality is like fighting the weather; it only creates pain.",
    "cut_start": 127.205,
    "cut_end": 131.491,
    "duration": 4.286,
    "speech_start": 127.38,
    "speech_end": 131.316
  },
  {
    "scene": 32,
    "script": "Accept the present moment as if you had chosen it yourself.",
    "cut_start": 131.491,
    "cut_end": 135.345,
    "duration": 3.854,
    "speech_start": 131.666,
    "speech_end": 135.17
  },
  {
    "scene": 33,
    "script": "Then take clear, decisive action from a place of deep stillness.",
    "cut_start": 135.345,
    "cut_end": 140.663,
    "duration": 5.318,
    "speech_start": 135.52,
    "speech_end": 140.488
  },
  {
    "scene": 34,
    "script": "When you stop fighting the present, mental noise fades into deep peace.",
    "cut_start": 140.663,
    "cut_end": 144.829,
    "duration": 4.166,
    "speech_start": 140.838,
    "speech_end": 144.654
  },
  {
    "scene": 35,
    "script": "You gain effortless focus, quiet confidence, and unshakeable clarity.",
    "cut_start": 144.829,
    "cut_end": 150.027,
    "duration": 5.198,
    "speech_start": 145.004,
    "speech_end": 149.852
  },
  {
    "scene": 36,
    "script": "The secret to a legendary life is not fixing the future.",
    "cut_start": 150.027,
    "cut_end": 153.953,
    "duration": 3.926,
    "speech_start": 150.202,
    "speech_end": 153.778
  },
  {
    "scene": 37,
    "script": "It is bringing your full, undefeated presence to the timeless now.",
    "cut_start": 153.953,
    "cut_end": 158.359,
    "duration": 4.406,
    "speech_start": 154.128,
    "speech_end": 158.184
  },
  {
    "scene": 38,
    "script": "So tell me in the comments below:",
    "cut_start": 158.359,
    "cut_end": 160.965,
    "duration": 2.606,
    "speech_start": 158.534,
    "speech_end": 160.79
  },
  {
    "scene": 39,
    "script": "Would you rather stay trapped in the anxious noise of your mind, or master the power of presence and conquer the now?",
    "cut_start": 160.965,
    "cut_end": 167.884,
    "duration": 6.919,
    "speech_start": 161.14,
    "speech_end": 167.884
  }
]